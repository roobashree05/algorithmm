APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/bugtracker
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
GITLAB_PROVIDER=mock
GITLAB_BASE_URL=
GITLAB_ACCESS_TOKEN=
GITLAB_WEBHOOK_SECRET=
GITLAB_MOCK_STATE_PATH=/data/mock/gitlab.json
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO

# Optional local settings. Empty webhook secrets fail closed.
# Docker Compose substitutes local-dev defaults when these are empty.
ATTACHMENT_DIR=/data/attachments
ATTACHMENT_MAX_BYTES=5000000
SEED_DEMO_DATA=true
ENABLE_OUTBOX_WORKER=true
CONVERSATION_TTL_MINUTES=120
NOTIFICATION_MAX_ATTEMPTS=5
RATE_LIMIT_PER_MINUTE=120
DEFAULT_LABELS=bug,whatsapp,customer-reported
